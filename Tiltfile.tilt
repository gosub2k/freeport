# Tiltfile

CTRL_REF = "localhost:32000/freeport-csi-controller:latest"
NODE_REF = "localhost:32000/freeport-csi-driver:latest"
MGR_REF = "localhost:32000/freeport-manager:latest"

# Set BUILDX_PLATFORMS=linux/amd64,linux/arm64 to enable multi-arch buildx builds
buildx_platforms = os.environ.get('BUILDX_PLATFORMS', '')
platforms_arg = ''
if buildx_platforms != '':
    platforms_arg = ' --platform ' + buildx_platforms

def make_build(ref, context, dockerfile, deps):
    if platforms_arg:
        # custom_build lets us call docker buildx directly
        custom_build(
            ref=ref,
            command=(
                'docker buildx build' + 
                ' --builder ' + os.environ.get('BUILDX_BUILDER', 'default') +
                platforms_arg +
                ' --push' +
                ' -t $EXPECTED_REF' +
                ' -f ' + dockerfile +
                ' ' + context
            ),
            deps=deps,
            skips_local_docker=True,
        )
    else:
        docker_build(
            ref=ref,
            context=context,
            dockerfile=dockerfile,
        )

make_build(CTRL_REF, 'csi_driver', 'csi_driver/Dockerfile.controller', ['csi_driver'])
make_build(NODE_REF, 'csi_driver', 'csi_driver/Dockerfile.node',       ['csi_driver'])
make_build(MGR_REF,  'csi_driver', 'csi_driver/Dockerfile.manager',    ['csi_driver'])

# Set KUSTOMIZE_DIR to point at a personal overlay (e.g. kustomize/overlays/example)
# that adds StorageClasses/test fixtures for your own cluster's specific
# devices — base alone has no StorageClasses at all.
kustomize_dir = os.environ.get('KUSTOMIZE_DIR', 'kustomize/base')
kustomize_yaml = kustomize(kustomize_dir)
k8s_yaml(kustomize_yaml)

k8s_resource(workload='freeport-csi-controller', port_forwards=[])
k8s_resource(workload='freeport-csi-driver',     port_forwards=[])
k8s_resource(workload='freeport-manager',        port_forwards=[])

#   DEPLOY_TEST_WORKLOAD=1 tilt up --file Tiltfile.tilt
if os.environ.get('DEPLOY_TEST_WORKLOAD', '') != '':
    k8s_yaml(kustomize('kustomize/test-workload'))
    k8s_resource(
        workload='test-csi-driver-narrow',
        # Attached explicitly, otherwise these land in Tilt's "uncategorized"
        # resource instead of alongside the workload they belong to.
        objects=[
            'freeport-test:namespace',
            'scratch-pvc-narrow:persistentvolumeclaim',
        ],
        port_forwards=[],
    )
